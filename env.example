# FloodMind Step 5 optional LLM settings
# Leave FLOODMIND_LLM_PROVIDER=none to use the local RAG template fallback.

FLOODMIND_LLM_PROVIDER=none
FLOODMIND_LLM_TIMEOUT=20

# Option A: OpenAI-compatible endpoint
# FLOODMIND_LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Option B: OpenRouter
# FLOODMIND_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Option C: Local Ollama
# FLOODMIND_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
